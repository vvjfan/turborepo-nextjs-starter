    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "@repo/db": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
